config SAMPLE_ROTARY_ENCODER_SW_PIN
    int
    prompt "Choose Rotary Encoder SW pin."
    depends on SAMPLE_ROTARY_ENCODER
    default 5
    help
        This option means choose the SW pin for rotary encoder.

config SAMPLE_ROTARY_ENCODER_DT_PIN
    int
    prompt "Choose Rotary Encoder DT pin."
    depends on SAMPLE_ROTARY_ENCODER
    default 6
    help
        This option means choose the DT pin for rotary encoder.

config SAMPLE_ROTARY_ENCODER_CLK_PIN
    int
    prompt "Choose Rotary Encoder CLK pin."
    depends on SAMPLE_ROTARY_ENCODER
    default 7
    help
        This option means choose the CLK pin for rotary encoder.

config SAMPLE_ROTARY_ENCODER_DEBUG
    bool
    prompt "Enable Rotary Encoder debug info"
    depends on SAMPLE_ROTARY_ENCODER
    default 0
    help
        This option means switch debug info print for rotary encoder.
